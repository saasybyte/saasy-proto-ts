{
  "name": "@saasybyte/saasy-proto-ts",
  "version": "0.1.27",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saasybyte/saasy-proto-ts.git"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "npm run generate && tsc && npm run copy-generated",
    "copy-generated": "cp -r src/generated dist/",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && echo 'Type checking passed'",
    "test": "npm run build && npm run lint",
    "prepublishOnly": "npm run test",
    "bump": "npm version patch"
  },
  "dependencies": {
    "protobufjs": "^7.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "fast-glob": "^3.3.3",
    "protobufjs-cli": "^1.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "mediasoup-client": "^3.16.3"
  }
}
